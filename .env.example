# ═══════════════════════════════════════════════════════════════
# WhatsApp Bulk Sender — Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# -- Telegram Bot (admin) ------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_IDS=123456789,987654321

# -- Language ---------------------------------------------------
# UI language: "id" (Indonesia) or "en" (English)
APP_LANG=id

# -- WhatsApp Provider ----------------------------------------
# Choose: "twilio", "meta", or "gowa"
WA_PROVIDER=gowa

# -- Twilio (if WA_PROVIDER=twilio) --------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# -- Meta Cloud API (if WA_PROVIDER=meta) --------------------
WA_PHONE_NUMBER_ID=123456789012345
WA_ACCESS_TOKEN=your_permanent_access_token_here
WA_API_VERSION=v21.0
WA_VERIFY_TOKEN=your_custom_verify_token_here

# -- GoWA self-hosted (if WA_PROVIDER=gowa) --------------------
# Your GoWA server base URL (no trailing slash)
GOWA_BASE_URL=https://whatsapp.masyamin.biz.id
# GoWA dashboard Basic Auth credentials
GOWA_USERNAME=your_gowa_username
GOWA_PASSWORD=your_gowa_password
# Optional: send from a specific device (X-Device-Id header).
# Leave empty to use the default device.
GOWA_DEVICE_ID=
# Anti-ban: minimum seconds between sends via GoWA (default 15)
GOWA_SEND_INTERVAL_SECONDS=15

# -- Webhook --------------------------------------------------
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
# HMAC secret for verifying GoWA incoming-message webhooks (X-Hub-Signature-256).
# MUST match --webhook-secret / WHATSAPP_WEBHOOK_SECRET on your GoWA server.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
GOWA_WEBHOOK_SECRET=your_random_secret_here

# -- Database -------------------------------------------------
DB_PATH=whatsapp_sender.db

# -- Rate Limiting --------------------------------------------
WA_MESSAGES_PER_SECOND=50

# -- Website --------------------------------------------------
WEBSITE_URL=https://soclose.co

# -- Dashboard ------------------------------------------------
DASHBOARD_PASSWORD=your_dashboard_password_here
DASHBOARD_PORT=8501
